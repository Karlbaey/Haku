{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n" | safeHTML }}
{{- $page := . -}}
{{- $site := .Site -}}
{{- $seo := partial "seo-context.html" (dict "page" $page) | transform.Unmarshal -}}
{{- $pages := slice -}}
{{- if $page.IsHome -}}
  {{- $mainSections := $site.Params.mainSections | default $site.MainSections | default (slice "articles") -}}
  {{- $pages = where $site.RegularPages "Section" "in" $mainSections -}}
{{- else -}}
  {{- $pages = $page.RegularPages -}}
{{- end -}}
{{- $limit := $site.Params.rss.fullContentLimit | default 10 -}}
{{- if ne $limit 0 -}}
  {{- $pages = $pages.ByDate.Reverse | first $limit -}}
{{- else -}}
  {{- $pages = $pages.ByDate.Reverse -}}
{{- end -}}
{{- $title := $seo.title -}}
{{- $description := $seo.description -}}
{{- $self := "" -}}
{{- with $page.OutputFormats.Get "FullRSS" -}}
  {{- $self = .Permalink -}}
{{- end -}}
{{- $lastBuildDate := "" -}}
{{- with index $pages 0 -}}
  {{- $lastBuildDate = (.Lastmod | default .Date).Format "Mon, 02 Jan 2006 15:04:05 -0700" -}}
{{- end -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $title }} - 全文</title>
    <link>{{ $site.BaseURL }}</link>
    <description>{{ $description }} - 全文 RSS，包含最新文章的完整内容</description>
    <generator>Hugo</generator>
    <language>{{ $seo.languageCode }}</language>
    {{- with $lastBuildDate }}
    <lastBuildDate>{{ . }}</lastBuildDate>
    {{- end }}
    {{- with $self }}
    <atom:link href="{{ . }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ printf "<![CDATA[%s]]>" .Content | safeHTML }}</description>
      {{- range .GetTerms "tags" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
